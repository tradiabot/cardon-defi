{
  "name": "cardon-defi",
  "version": "1.0.0",
  "private": true,
  "description": "Bot DeFi POL/USDC en Cloudflare Workers: cron, D1, Groq y cotizaciones DEX reales (modo paper).",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cardon_defi --local",
    "db:migrate:remote": "wrangler d1 migrations apply cardon_defi --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "viem": "^2.57.2"
  }
}
