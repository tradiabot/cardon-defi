{
  "name": "cardon-comunidad",
  "version": "1.0.0",
  "private": true,
  "description": "Cardón Comunidad: registro voluntario por correo y reportes anónimos de errores y arreglos (Cloudflare Pages + D1).",
  "scripts": {
    "deploy": "wrangler pages deploy",
    "db:schema": "wrangler d1 execute cardon_comunidad --remote --file schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
